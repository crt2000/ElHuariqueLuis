    {
      "name": "2. Categorías",
      "description": "CRUD de categorías. Crea la categoría Postres, que se usa en Platos y se elimina en Limpieza.",
      "item": [
        {
          "name": "Listar categorías",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/categorias",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "categorias"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", function () { pm.response.to.have.status(200); });",
                  "const lista = pm.response.json();",
                  "pm.test(\"Hay categorías cargadas\", function () { pm.expect(lista.length).to.be.above(0); });",
                  "// Guarda el id de \"Ceviches\" para probar el 409 (tiene platos asociados)",
                  "const cev = lista.find(c => c.nombre === \"Ceviches\");",
                  "if (cev) { pm.collectionVariables.set(\"categoriaConPlatosId\", cev.id); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Crear categoría (201)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/categorias",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "categorias"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Postres\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 201\", function () { pm.response.to.have.status(201); });",
                  "const c = pm.response.json();",
                  "pm.test(\"Devuelve el id generado\", function () { pm.expect(c.id).to.be.a(\"number\"); });",
                  "pm.collectionVariables.set(\"categoriaId\", c.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Obtener categoría por id",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/categorias/{{categoriaId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "categorias",
                "{{categoriaId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Es la categoría creada\", function () { pm.expect(pm.response.json().nombre).to.eql(\"Postres\"); });"
                ]
              }
            }
          ]
        },
