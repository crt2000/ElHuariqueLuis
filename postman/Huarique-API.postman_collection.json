  "item": [
    {
      "name": "1. Sedes",
      "description": "Consulta de las sedes cargadas por DataLoader.",
      "item": [
        {
          "name": "Listar sedes",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/sedes",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "sedes"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", function () { pm.response.to.have.status(200); });",
                  "const sedes = pm.response.json();",
                  "pm.test(\"Hay al menos una sede\", function () { pm.expect(sedes.length).to.be.above(0); });",
                  "if (sedes.length) { pm.collectionVariables.set(\"sedeId\", sedes[0].id); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Obtener sede por id",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/sedes/{{sedeId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "sedes",
                "{{sedeId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Sede inexistente (404)",
